// Agora Firestore security rules.
// Not deployed automatically (Agora has no Firebase CLI/build step) - paste
// this into the Firebase console under Firestore Database -> Rules.
//
// One document per member in `profiles`, keyed by their Auth UID. Anyone
// (including signed-out visitors) can read every profile, matching the
// public member-card pages. The signed-in owner of a profile can create
// or edit it, but cannot change its own `status` (active/suspended) -
// only the admin account (Christopher Bruckmann, VirtuaMakers@Outlook.com)
// can suspend, reinstate, or delete any profile. Owners can still delete
// their own profile outright.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'active';

      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.status == resource.data.status)
      );

      allow delete: if request.auth != null
        && (isAdmin() || request.auth.uid == uid);

      // Genuinely private profile data (e.g. the State/Province/Territory
      // field, used only to disambiguate the location map's geocoding
      // query) - unlike the parent `profiles/{uid}` doc above, this is
      // NOT world-readable. Only the profile's own owner can read or write
      // it; nobody else, not even other signed-in members. This is the
      // pattern for any future field that needs to be actually private
      // (server-enforced), not just hidden from the UI - see CLAUDE.md.
      match /private/{document} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Homepage hit counter - a single document anyone (including
    // signed-out visitors) can bump by exactly 1 per write. Starts at
    // 100 on first creation. No resets, no jumps, no other fields.
    match /meta/hits {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 100;

      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Communiqués 📨 - every form of it (Wall posts/comments, Dialogs)
    // shares one visibility rule: readable by any signed-in Agora member,
    // never by signed-out visitors, and never scraped into a
    // public/anonymous view the way `profiles` is. Writing a Dialog
    // message is still restricted to its two participants -
    // "member-readable" is not "member-writable" - but reading one is
    // not restricted to those two, by design (see CLAUDE.md).
    //
    // Every piece of content (wall post, wall comment, message) is
    // editable AND deletable by its own author for exactly 10 minutes
    // after creation, then permanently locked and undeletable - see
    // editableWithinWindow() / deletableWithinWindow().

    // A conversation's participant list can't change after creation, and
    // only the two participants can create it or send messages in it -
    // but (per the member-readable rule above) any signed-in member can
    // read a Dialog once it exists, e.g. via the other participant's
    // profile page. Creating one requires an accepted friendship between
    // the two participants (Chris, 2026-08-06) - Dialogs are friends-only -
    // except when one participant is a static profile-page slug, which
    // stays open to any signed-in member (see allowsStaticParticipant()).
    match /conversations/{conversationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && (isAcceptedFriendship(request.resource.data.participants)
          || allowsStaticParticipant(request.resource.data.participants));

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && validBody(request.resource.data.body);

        allow update: if editableWithinWindow(['body']);
        allow delete: if deletableWithinWindow();
      }
    }

    // Communiqués 📨 - a member's Wall. `profileUid` names whose Wall the
    // post is on; any signed-in member may post or comment on any Wall
    // (not just their own), matching a typical social-wall model.
    match /wallPosts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.profileUid is string
        && validBody(request.resource.data.body);

      allow update: if editableWithinWindow(['body']);
      allow delete: if deletableWithinWindow();

      // Commenting bumps the parent post's counters. Locked to exactly
      // these two fields so a comment can't rewrite someone else's post.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastActivityAt']);

      match /comments/{commentId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && validBody(request.resource.data.body);

        allow update: if editableWithinWindow(['body']);
        allow delete: if deletableWithinWindow();
      }
    }

    // Friends 🙂 - a symmetrical relationship between two members, stored
    // once per pair (doc ID = the two participants' UIDs sorted and
    // joined with `_`, same pattern as `conversations`). No limit on how
    // many friends a member can have. A pending request is readable only
    // by its two participants - not member-readable the way Communiqués
    // content is - since an unanswered request isn't a public fact yet.
    // Whether two members are friends is a private fact between them,
    // matching that same instinct once accepted.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the *other* participant can accept a pending request - the
      // requester can't accept their own request to skip the other
      // person's consent.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.requestedBy == resource.data.requestedBy;

      // Either participant can delete at any time - covers canceling a
      // pending request, declining one, or unfriending later.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }

    function isAdmin() {
      return request.auth.token.email == 'VirtuaMakers@Outlook.com';
    }

    // Dialogs between two real members require an accepted friendship.
    // `participants` must already be sorted (every client writes
    // [uidA, uidB].sort()), same assumption the friendship doc ID itself
    // relies on. The 30 static profile pages (Agora/profiles/*.html) use a
    // slug as a stand-in participant ID since those members have no real
    // Firestore/Auth account and so can't have a Friends relationship at
    // all yet (pending Agora Harness 🚡) - Dialogs with one of those stay
    // open to any signed-in member, unchanged, via allowsStaticParticipant().
    function isAcceptedFriendship(participants) {
      let friendshipId = participants[0] + '_' + participants[1];
      return exists(/databases/$(database)/documents/friendships/$(friendshipId))
        && get(/databases/$(database)/documents/friendships/$(friendshipId)).data.status == 'accepted';
    }

    function allowsStaticParticipant(participants) {
      return !exists(/databases/$(database)/documents/profiles/$(participants[0]))
        || !exists(/databases/$(database)/documents/profiles/$(participants[1]));
    }

    function validBody(body) {
      return body is string && body.size() > 0 && body.size() <= 9999;
    }

    // Shared by every Communiqués content type: only the original author,
    // only within 10 minutes of creation, and only touching the given
    // content field(s) - never authorUid, createdAt, or any counter field.
    function editableWithinWindow(fields) {
      return request.auth != null
        && request.auth.uid == resource.data.authorUid
        && request.time < resource.data.createdAt + duration.value(10, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Same 10-minute window as editableWithinWindow(), but for deletes -
    // no request.resource on a delete, so there's no fields diff to check.
    function deletableWithinWindow() {
      return request.auth != null
        && request.auth.uid == resource.data.authorUid
        && request.time < resource.data.createdAt + duration.value(10, 'm');
    }
  }
}
