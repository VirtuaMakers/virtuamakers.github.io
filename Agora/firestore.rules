// Agora Firestore security rules.
// Not deployed automatically (Agora has no Firebase CLI/build step) - paste
// this into the Firebase console under Firestore Database -> Rules.
//
// One document per member in `profiles`, keyed by their Auth UID. Anyone
// (including signed-out visitors) can read every profile, matching the
// public member-card pages. The signed-in owner of a profile can create
// or edit it, but cannot change its own `status` (active/suspended) -
// only the admin account (Christopher Bruckmann, VirtuaMakers@Outlook.com)
// can suspend, reinstate, or delete any profile. Owners can still delete
// their own profile outright.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'active';

      allow update: if request.auth != null && (
        isFullAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.status == resource.data.status)
      );

      // Invisible view counter (Chris, 2026-08-13) - anyone, including a
      // signed-out visitor, can bump profileViews by exactly one field,
      // matching this doc's public read. Not surfaced in any UI yet -
      // internal-only metric, see CLAUDE.md.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileViews']);

      allow delete: if request.auth != null
        && (isFullAdmin() || request.auth.uid == uid);

      // Genuinely private profile data (e.g. the State/Province/Territory
      // field, used only to disambiguate the location map's geocoding
      // query) - unlike the parent `profiles/{uid}` doc above, this is
      // NOT world-readable. Only the profile's own owner can read or write
      // it; nobody else, not even other signed-in members. This is the
      // pattern for any future field that needs to be actually private
      // (server-enforced), not just hidden from the UI - see CLAUDE.md.
      match /private/{document} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // One doc per registered device, doc ID = the FCM token itself (so
      // re-registering the same device is a natural overwrite, not a
      // duplicate). Owner-only, same private pattern as above - nobody
      // else has any reason to read another member's push tokens.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Push/toast notifications - one doc per notified event, written only
    // by Cloud Functions (Admin SDK, which bypasses these rules entirely -
    // allow write: if false is correct here, not a bug) when a Dialog
    // message, Wall post, or Wall comment happens. Only the recipient can
    // ever read their own notifications - never member-readable like
    // Communiqués content itself, since a notification is personal
    // metadata about who got told what, not a public post.
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.recipientUid;

      // A recipient can mark their own notification `seen` (and only
      // that field) - what lets notification-toast.js catch someone up
      // on what they missed the next time they sign in or revisit,
      // without re-showing the same notification forever (Chris,
      // 2026-09-10). Creating/deleting a notification is still
      // Admin-SDK-only, same as before - this doesn't touch that.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);

      allow create, delete: if false;
    }

    // Homepage hit counter - a single document anyone (including
    // signed-out visitors) can bump by exactly 1 per write. Starts at
    // 100 on first creation. No resets, no jumps, no other fields.
    match /meta/hits {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 100;

      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // Communiqués 📨 - every form of it (Wall posts/comments, Dialogs)
    // shares one visibility rule: readable by any signed-in Agora member,
    // never by signed-out visitors, and never scraped into a
    // public/anonymous view the way `profiles` is. Writing a Dialog
    // message is still restricted to its two participants -
    // "member-readable" is not "member-writable" - but reading one is
    // not restricted to those two, by design (see CLAUDE.md).
    //
    // Every piece of content (wall post, wall comment, message) is
    // editable AND deletable by its own author for exactly 10 minutes
    // after creation, then permanently locked and undeletable - see
    // editableWithinWindow() / deletableWithinWindow().

    // Messaging is open by default (Chris, 2026-08-06) - any signed-in
    // member can start a Dialog with, or be added to a group Dialog by,
    // any other member, unless that member has opted into requiring an
    // accepted friendship first (`requireFriendToMessage` on their own
    // profiles/{uid} doc, set from create-profile.html - off by default).
    // A member with no profile doc at all (the 30 static profile-page
    // slugs) is always open, same as anyone who's left the field off -
    // see canMessage()/requiresFriendship() below. A conversation always
    // starts as exactly two participants and can grow into a group
    // afterward by adding one member at a time, up to 1,000 total (a
    // quiet backstop against abuse, not a published feature - see
    // CLAUDE.md). Any signed-in member can still read a Dialog once it
    // exists, participant or not, per the member-readable rule above -
    // joining the `participants` array only grants the ability to send
    // messages and puts it in that member's own inbox, not new read access
    // they didn't already have.
    match /conversations/{conversationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && canMessage(request.auth.uid,
          request.resource.data.participants[0] == request.auth.uid
            ? request.resource.data.participants[1]
            : request.resource.data.participants[0]);

      // Sending a message bumps lastMessage/lastMessageAt without touching
      // participants at all. Dialogs are permanently fixed at exactly 2
      // participants once created (Chris, 2026-08-15) - group Dialogs (the
      // add-participant/leave branches this replaced) never saw real use,
      // and that same participants-array/add-leave shape is being
      // repurposed as Multi-Chat's foundation instead, as its own
      // collection, rather than living here.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null;

        // canSendInConversation() re-checks the block relationship on
        // every message, not just at Dialog creation (Chris, 2026-09-14) -
        // a block made mid-conversation should stop new messages
        // immediately, the same way canPostToWall()/canCreateComment()
        // already re-check on every Wall write, not just the first one.
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && validBody(request.resource.data.body)
          && canSendInConversation(request.auth.uid, conversationId);

        allow update: if editableWithinWindow(['body']);
        allow delete: if deletableWithinWindow();

        // View counts (Chris, 2026-08-13) - any signed-in member can bump
        // a message's viewCount, same bump-only pattern as the Wall
        // counters below. Not deduped per viewer - matches the homepage
        // hit counter's own simplicity, see CLAUDE.md.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
      }
    }

    // Communiqués 📨 - a member's Wall. `profileUid` names whose Wall the
    // post is on; any signed-in member may post or comment on any Wall
    // (not just their own) by default, matching a typical social-wall
    // model - unless the wall's owner has opted into requiring an
    // accepted friendship first (requireFriendToPost, off by default -
    // Chris, 2026-08-17, same opt-in shape as requireFriendToMessage for
    // Dialogs, added after Chris flagged wanting a way to stop strangers
    // from being able to flame his own Wall once the site gets more
    // visible). See canPostToWall()/canCreateComment() below.
    match /wallPosts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.profileUid is string
        && validBody(request.resource.data.body)
        && canPostToWall(request.auth.uid, request.resource.data.profileUid);

      allow update: if editableWithinWindow(['body']);
      allow delete: if deletableWithinWindow();

      // Commenting bumps the parent post's counters. Locked to exactly
      // these two fields so a comment can't rewrite someone else's post.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastActivityAt']);

      // View counts (Chris, 2026-08-13) - see the messages/{messageId}
      // rule above for the same pattern and reasoning.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);

      match /comments/{commentId} {
        allow read: if request.auth != null;

        // Capped at 100 comments per post (Chris, 2026-08-15) and gated
        // by the same requireFriendToPost setting as top-level posts
        // (Chris, 2026-08-17) - both checked in canCreateComment() below
        // off a single fetch of the parent post, since a comment lands on
        // the same Wall a top-level post would.
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && validBody(request.resource.data.body)
          && canCreateComment(request.auth.uid, postId);

        allow update: if editableWithinWindow(['body']);
        allow delete: if deletableWithinWindow();

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
      }
    }

    // Friends 🙂 - a symmetrical relationship between two members, stored
    // once per pair (doc ID = the two participants' UIDs sorted and
    // joined with `_`, same pattern as `conversations`). No limit on how
    // many friends a member can have. A pending request is readable only
    // by its two participants - not member-readable the way Communiqués
    // content is - since an unanswered request isn't a public fact yet.
    // Whether two members are friends is a private fact between them,
    // matching that same instinct once accepted.
    match /friendships/{friendshipId} {
      // A member's own "Add Friend" button has to onSnapshot-watch this
      // exact doc path *before* any friendship exists yet, to know
      // whether to show Add Friend vs. a pending/accepted state - and
      // when the doc doesn't exist, `resource` is null, so
      // `resource.data.participants` would throw and (per Firestore's
      // own documented behavior for rule-evaluation errors) silently
      // deny the read, permanently. The `!exists(...)` branch fixes that:
      // confirming a friendship doc is absent reveals nothing private, so
      // it's always allowed; once the doc exists, the original
      // participants-only restriction still applies unchanged.
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/friendships/$(friendshipId))
            || request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && !isBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);

      // Only the *other* participant can accept a pending request - the
      // requester can't accept their own request to skip the other
      // person's consent.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.requestedBy == resource.data.requestedBy;

      // Either participant can delete at any time - covers canceling a
      // pending request, declining one, or unfriending later.
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }

    // Blocking (Chris, 2026-09-14) - a real per-person block, the gap
    // flagged once Octopus Style's own live test made "so long as you can
    // block someone, they should be able to dialog whoever" a real
    // question rather than a hypothetical. Deliberately directional, not a
    // sorted pair like friendships/conversations - a block is one person's
    // own decision about another, not a mutual state either side agreed
    // to, so A blocking B and B blocking A are two independent possible
    // docs, not one shared one. Doc ID is "{blockerUid}_{blockedUid}"
    // (unsorted, unlike friendships/conversations) so the two uids can be
    // read directly off the path via split('_') - this avoids needing the
    // friendships collection's own !exists()-before-resource.data gotcha
    // entirely, since the read rule never needs to look at resource.data
    // at all, only the path itself.
    //
    // Deliberately asymmetric visibility: only the blocker can ever read
    // their own block record - the blocked person is never told they've
    // been blocked, matching how blocking works on every mainstream social
    // platform (Facebook, X, etc.) and Chris's own "you can block someone"
    // framing, which was about a real tool existing, not about announcing
    // it. isBlocked() below (used by canMessage()/canPostToWall()/
    // canSendInConversation()) checks both directions via get()/exists(),
    // which always succeeds server-side regardless of the caller's own
    // read permissions - the same mechanic isFriendsWith() already relies
    // on - so a block still silently prevents contact both ways even
    // though only the blocker can see the record that's doing it.
    match /blocks/{blockId} {
      allow read: if request.auth != null
        && request.auth.uid == blockId.split('_')[0];

      allow create: if request.auth != null
        && blockId.split('_')[0] == request.auth.uid
        && blockId.split('_')[1] == request.resource.data.blockedUid
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid;

      // Unblocking - only the blocker can remove their own block.
      allow delete: if request.auth != null
        && blockId.split('_')[0] == request.auth.uid;

      allow update: if false;
    }

    // VirtuaMakers Calendar 🗓️ - real, member-created meetings (Chris,
    // 2026-09-23), the "native scheduling" half of Meeting Relay - see
    // CLAUDE.md's "VirtuaMakers Calendar 🗓️ / Meeting Relay, scoped
    // further" entry. Participant-based like conversations/friendships,
    // but deliberately NOT member-readable the way Wall/Dialogs are - a
    // meeting's own participants are its only audience, since a
    // meeting time/subject is personal scheduling information, not a
    // public post.
    //
    // Known, accepted v1 gap, flagged rather than silently skipped:
    // unlike conversations/wallPosts, creating an event does not check
    // isBlocked() against every invited participant - Firestore rules
    // has no loop construct to check an arbitrary-length array against
    // exists()/get() lookups, and (since a block is only ever visible
    // to the blocker) the client couldn't filter this client-side
    // either. Low-risk in practice: a participant who's blocked the
    // creator can just remove themselves via the "leave" update rule
    // below the moment they see the invite, the same recourse Dialogs/
    // Wall already give a blocked-in-spirit relationship once contact
    // has already happened once.
    match /calendarEvents/{eventId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // participants only requires >= 1 (the creator), not >= 2 - a
      // meeting with a real-world contact who has no Agora account
      // (a Boardy-style invite, or just a solo self-reminder) is a
      // legitimate event with exactly one real Agora participant, not
      // an error case.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 12
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.startAt is timestamp
        && request.resource.data.reminderMinutesBefore is int
        && request.resource.data.reminderSent == false;

      // Only the creator can edit a meeting's own details before it
      // happens - deliberately minimal for v1, the same "single clear
      // authority" shape admins/{uid} already uses, rather than a full
      // per-participant edit model. `reminderSent` is never in this
      // field list on purpose - only sendCalendarEventReminders (Admin
      // SDK, bypasses these rules entirely) ever flips it.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'startAt', 'reminderMinutesBefore', 'meetingUrl', 'linkPath']);

      // Any participant can remove themselves (a decline/leave) without
      // the creator's involvement - the creator cancels the whole thing
      // via delete instead, not by leaving their own meeting.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants.size() == resource.data.participants.size() - 1
        && resource.data.participants.hasAll(request.resource.data.participants)
        && !(request.auth.uid in request.resource.data.participants);

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Newsletter 📬 - a single draft doc (subject + plain-text body) that
    // Chris prepares via newsletter-compose.html, ideally by the 27th of
    // each month, for the sendMonthlyNewsletter Cloud Function to send
    // automatically on the 1st (or sendNewsletterNow to send immediately,
    // admin-triggered). Admin-only in both directions - not a public
    // collection, and not member-readable like Communiqués - since it's
    // just a staging area for content that isn't public until it's
    // actually emailed out.
    match /newsletter/{document} {
      allow read, write: if isFullAdmin();
    }

    // Newsletter 📬 archive (Chris, 2026-09-02) - one doc per issue
    // actually sent, written only by performNewsletterSend() in
    // functions/index.js (Admin SDK, bypasses these rules - allow write:
    // if false is correct here, matching notifications/{id}'s same
    // pattern elsewhere in this file). World-readable on purpose, unlike
    // the draft above - once an issue has actually gone out, Chris wants
    // it browsable by anyone on newsletter-archive.html, the same way any
    // other public page here is.
    match /newsletterIssues/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Content moderation 🛡️ - every block/flag the moderateText and
    // moderateImage Cloud Functions record, plus appeal state. Only ever
    // written by the Admin SDK (moderateText/moderateImage/
    // requestModerationAppeal/resolveModerationAppeal all run server-side),
    // so client writes are never allowed here at all - moderation-review.js
    // reads this collection directly, but every action a moderator takes
    // goes through resolveModerationAppeal instead of a direct write.
    // Moderators can see this queue too, not just full admins/the owner -
    // reviewing flagged/blocked content is exactly a moderator's job.
    match /moderationLog/{document} {
      allow read: if isAtLeastModerator();
      allow write: if false;
    }

    // Multi-admin system (Chris, 2026-08-15) - one doc per member who's
    // been granted a role beyond ordinary member, doc ID = their uid.
    // VirtuaMakers@Outlook.com is a separate, permanent "owner" account
    // that's never stored here and can never be locked out - it's checked
    // by email in isOwner() below, not by a doc that could be deleted.
    // Only the owner can grant or revoke a role (admin or moderator) -
    // deliberately not delegated to admins themselves, so there's always
    // one clear, single authority over who else has elevated access. A
    // member can read their own role doc (so the client can show/hide
    // admin UI for themselves); nobody but the owner can read anyone
    // else's, since who holds admin/moderator status isn't public
    // information the way a profile is.
    match /admins/{uid} {
      allow read: if request.auth != null
        && (isOwner() || request.auth.uid == uid);
      allow write: if isOwner();
    }

    // Case-insensitive on purpose - email addresses are case-insensitive
    // by spec, and Firebase Auth doesn't normalize the casing of
    // request.auth.token.email for you, so a literal == comparison here
    // would silently lock the real owner out if their account's email
    // happens to differ in case from this exact string (e.g. was typed in
    // lowercase at signup).
    function isOwner() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() == 'virtuamakers@outlook.com';
    }

    // Full admin power (suspend/delete accounts, newsletter, granting
    // nothing themselves - only the owner grants) - the owner always
    // qualifies, plus anyone with an admins/{uid} doc whose role is
    // "admin".
    function isFullAdmin() {
      return isOwner()
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin');
    }

    // Moderator or above - covers the moderation queue only, not account
    // suspend/delete or the newsletter.
    function isAtLeastModerator() {
      return isFullAdmin()
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'moderator');
    }

    // Whether two arbitrary uids (not already known to be sorted) are
    // accepted friends - sorts inline since lists have no generic sort()
    // in rules language. Backs canMessage() below.
    function isFriendsWith(a, b) {
      let friendshipId = a < b ? a + '_' + b : b + '_' + a;
      return exists(/databases/$(database)/documents/friendships/$(friendshipId))
        && get(/databases/$(database)/documents/friendships/$(friendshipId)).data.status == 'accepted';
    }

    // Blocking is checked in both directions - either party having blocked
    // the other stops all contact between them, not just the direction the
    // block was made in (matches canMessage()/canPostToWall() both being
    // asked "can these two interact," not "did the sender get blocked").
    function isBlocked(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // Whether `uid` has opted into requiring an accepted friendship before
    // anyone can message them (Chris, 2026-08-06 - messaging is open by
    // default; this is the opt-in exception, set from create-profile.html).
    // A uid with no profile doc at all - the 30 static profile-page slugs -
    // resolves to false (open), same as anyone who left the field off.
    function requiresFriendship(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.requireFriendToMessage == true;
    }

    // The actual permission check for starting or joining a Dialog: open
    // unless the target requires friendship, in which case the sender must
    // already be friends with them.
    function canMessage(sender, target) {
      return !isBlocked(sender, target)
        && (!requiresFriendship(target) || isFriendsWith(sender, target));
    }

    // Re-checked on every message, not just when a Dialog is first
    // created - see the messages/{messageId} create rule above.
    function canSendInConversation(sender, conversationId) {
      let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return sender in conv.participants
        && !isBlocked(conv.participants[0], conv.participants[1]);
    }

    // Same opt-in shape as requiresFriendship() above, but for posting on
    // someone's Wall rather than starting a Dialog with them - a separate
    // field (requireFriendToPost) since a member might want one open and
    // the other locked down (Chris, 2026-08-17). Off by default; a uid
    // with no profile doc at all (the 30 static profile-page slugs)
    // resolves to false (open), same reasoning as requiresFriendship().
    function requiresFriendshipToPost(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.requireFriendToPost == true;
    }

    // sender == wallOwner (posting or commenting on your own Wall) is
    // always allowed and short-circuits before the friendship check -
    // without this, turning requireFriendToPost on would lock a member
    // out of their own Wall, since no friendship doc with yourself can
    // ever exist.
    function canPostToWall(sender, wallOwner) {
      return sender == wallOwner
        || (!isBlocked(sender, wallOwner)
          && (!requiresFriendshipToPost(wallOwner) || isFriendsWith(sender, wallOwner)));
    }

    // A comment lands on the same Wall a top-level post would, so it's
    // gated by the same requireFriendToPost setting as canPostToWall()
    // above - fetches the parent post once for both the friendship check
    // (against its profileUid, i.e. the Wall it's actually on) and the
    // existing 100-comment cap, rather than two separate get() calls.
    function canCreateComment(sender, postId) {
      let post = get(/databases/$(database)/documents/wallPosts/$(postId)).data;
      return post.commentCount < 100 && canPostToWall(sender, post.profileUid);
    }

    function validBody(body) {
      return body is string && body.size() > 0 && body.size() <= 9999;
    }

    // Shared by every Communiqués content type: only the original author,
    // only within 10 minutes of creation, and only touching the given
    // content field(s) - never authorUid, createdAt, or any counter field.
    function editableWithinWindow(fields) {
      return request.auth != null
        && request.auth.uid == resource.data.authorUid
        && request.time < resource.data.createdAt + duration.value(10, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Same 10-minute window as editableWithinWindow(), but for deletes -
    // no request.resource on a delete, so there's no fields diff to check.
    function deletableWithinWindow() {
      return request.auth != null
        && request.auth.uid == resource.data.authorUid
        && request.time < resource.data.createdAt + duration.value(10, 'm');
    }
  }
}
